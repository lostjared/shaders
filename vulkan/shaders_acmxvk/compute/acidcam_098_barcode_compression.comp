#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



float hash11(float value) {
    return fract(sin(value * 193.17) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    int group = position.x / 5;
    float code = hash11(float(group + iFrame / 10));
    int width = 1 + int(code * mix(2.0, 14.0, alpha));
    int anchor_x = (position.x / width) * width;
    int vertical_jump = int((hash11(float(group * 7 + iFrame / 4)) - 0.5) * 90.0 * alpha);
    vec3 source = source_at(position, size);
    vec3 compressed = source_at(ivec2(anchor_x, position.y + vertical_jump), size);
    float bar = step(0.5, fract(float(position.x) / float(width) + code));
    compressed *= mix(0.48, 1.35, bar);
    imageStore(outputImage, position, vec4(mix(source, compressed, alpha * 0.9), 1.0));
}
