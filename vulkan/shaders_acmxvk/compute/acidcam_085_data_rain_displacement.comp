#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



float hash11(float value) {
    return fract(sin(value * 73.156) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    int column = position.x / 8;
    float speed = 1.0 + floor(hash11(float(column)) * 7.0);
    float head = mod(float(iFrame) * speed + hash11(float(column + 91)) * float(size.y), float(max(size.y, 1)));
    float trail = mod(head - float(position.y) + float(size.y), float(max(size.y, 1)));
    float rain = smoothstep(90.0, 0.0, trail) * step(trail, 90.0);
    int drop = int((hash11(float(column + iFrame / 5)) - 0.5) * 80.0 * alpha * rain);
    vec3 source = source_at(position, size);
    vec3 shifted = source_at(position + ivec2(drop, int(trail * 0.35)), size);
    vec3 tint = shifted * vec3(0.35, 1.15, 0.62);
    imageStore(outputImage, position, vec4(mix(source, tint, rain * alpha), 1.0));
}
