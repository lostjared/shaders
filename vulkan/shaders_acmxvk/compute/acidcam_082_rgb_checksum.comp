#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    vec3 source = source_at(position, size);
    uvec3 bytes = uvec3(clamp(source, 0.0, 1.0) * 255.0);
    uint address = uint(position.x * 131 + position.y * 197 + iFrame * 17);
    uint checksum = bytes.r ^ (bytes.g << 1) ^ (bytes.b << 2) ^ address;
    uint mask = (checksum >> uint((position.x + position.y) & 7)) & 7u;
    vec3 corrupt = vec3(uvec3(bytes.r ^ (mask * 17u),
                              bytes.g ^ (mask * 29u),
                              bytes.b ^ (mask * 43u))) / 255.0;
    float gate = step(mix(7.0, 2.0, alpha), float(checksum & 7u));
    vec3 color = mix(source, corrupt, gate * alpha);
    imageStore(outputImage, position, vec4(color, 1.0));
}
