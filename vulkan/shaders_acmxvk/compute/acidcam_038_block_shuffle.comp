#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



ivec2 clampPos(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

vec2 pixelUv(ivec2 p, ivec2 size) {
    return (vec2(clampPos(p, size)) + 0.5) / vec2(size);
}

vec3 sampleSource(ivec2 p, ivec2 size) {
    return textureLod(samp, pixelUv(p, size), 0.0).rgb;
}

int effectBlockSize() {
    return max(int(round(mix(2.0, 64.0, clamp(alpha, 0.0, 1.0)))), 1);
}

int effectDirection() {
    return ((iFrame / 8) & 1) == 0 ? 1 : -1;
}

float hash12(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

vec3 blockShuffle(ivec2 p, ivec2 size) {
    int block = effectBlockSize();
    ivec2 base = (p / block) * block;
    vec2 key = vec2(base) + vec2(float(iFrame), float(effectDirection()) * 19.0);
    ivec2 offset = ivec2(int(hash12(key + vec2(4.1, 1.7)) * float(block)),
                         int(hash12(key + vec2(2.3, 8.8)) * float(block)));
    return sampleSource(base + offset + (p - base), size);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(p, size)))
        return;
    vec3 color = blockShuffle(p, size);
    imageStore(outputImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
}
