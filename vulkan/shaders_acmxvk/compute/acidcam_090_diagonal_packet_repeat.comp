#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



float hash11(float value) {
    return fract(sin(value * 147.13) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    int diagonal = (position.x + position.y * 2) / 24;
    float seed = hash11(float(diagonal + iFrame / 8));
    int repeat_length = 8 + int(seed * 48.0);
    int along = position.x - position.y;
    int repeated = ((along % repeat_length) + repeat_length) % repeat_length;
    ivec2 repeat_position = position + ivec2(repeated - repeat_length / 2,
                                              -(repeated - repeat_length / 2));
    float gate = step(mix(0.97, 0.42, alpha), seed);
    vec3 source = source_at(position, size);
    vec3 packet = source_at(repeat_position, size);
    imageStore(outputImage, position, vec4(mix(source, packet.brg, gate * alpha), 1.0));
}
