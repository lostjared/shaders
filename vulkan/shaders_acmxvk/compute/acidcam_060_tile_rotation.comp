#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(91.17, 27.31))) * 41719.118);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    int tile_size = max(8, int(mix(48.0, 16.0, alpha)));
    ivec2 cell = position / tile_size;
    ivec2 local_position = position % tile_size;
    int turns = int(hash12(vec2(cell) + float(iFrame / 12)) * 4.0);
    ivec2 rotated = local_position;
    if (turns == 1) rotated = ivec2(tile_size - 1 - local_position.y, local_position.x);
    else if (turns == 2) rotated = ivec2(tile_size - 1) - local_position;
    else if (turns == 3) rotated = ivec2(local_position.y, tile_size - 1 - local_position.x);
    ivec2 sample_position = cell * tile_size + rotated;
    vec3 source = source_at(position, size);
    vec3 transformed = source_at(sample_position, size);
    imageStore(outputImage, position, vec4(mix(source, transformed, alpha), 1.0));
}
