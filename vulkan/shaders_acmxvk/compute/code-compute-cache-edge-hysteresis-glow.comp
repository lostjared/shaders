// Stateful cooperative compute effect inspired by shaders_new.
#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define history_head int(ext.u3.x)
#define iFrame int(ext.u2.x)
#define time_f ext.u2.y

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



#ifndef SIZE
#define SIZE 8
#endif
#ifndef USE_HISTORY_TEXTURE_ARRAY
#define USE_HISTORY_TEXTURE_ARRAY 1
#endif
#if USE_HISTORY_TEXTURE_ARRAY
layout(set = 0, binding = 2) uniform sampler2DArray history;

#else
uniform sampler2D textures[SIZE];
#endif
shared vec4 tile[10][10];
ivec2 clamp_position(ivec2 p, ivec2 s) { return clamp(p, ivec2(0), s - 1); }
vec4 source_at(ivec2 p, ivec2 s) {
    vec2 uv = (vec2(clamp_position(p, s)) + 0.5) / vec2(s);
    return textureLod(samp, uv, 0.0);
}
vec4 history_at(int index, ivec2 p, ivec2 s) {
    vec2 uv = (vec2(clamp_position(p, s)) + 0.5) / vec2(s);
    index = clamp(index, 0, min(SIZE, 8) - 1);
#if USE_HISTORY_TEXTURE_ARRAY
    return textureLod(history, vec3(uv, float((history_head + index) % SIZE)), 0.0);
#else
    if (index == 0) return textureLod(textures[0], uv, 0.0);
#if SIZE > 1
    if (index == 1) return textureLod(textures[1], uv, 0.0);
#endif
#if SIZE > 2
    if (index == 2) return textureLod(textures[2], uv, 0.0);
#endif
#if SIZE > 3
    if (index == 3) return textureLod(textures[3], uv, 0.0);
#endif
#if SIZE > 4
    if (index == 4) return textureLod(textures[4], uv, 0.0);
#endif
#if SIZE > 5
    if (index == 5) return textureLod(textures[5], uv, 0.0);
#endif
#if SIZE > 6
    if (index == 6) return textureLod(textures[6], uv, 0.0);
#endif
#if SIZE > 7
    return textureLod(textures[7], uv, 0.0);
#else
    return textureLod(textures[0], uv, 0.0);
#endif
#endif
}
float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec3 acid_palette(float p) { return 0.5 + 0.5 * cos(6.2831853 * (p + vec3(0.06, 0.39, 0.73))); }
void load_tile(ivec2 size) {
    uint lane = gl_LocalInvocationIndex;
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 8 - 1;
    for (uint index = lane; index < 100u; index += 64u) {
        ivec2 q = ivec2(int(index % 10u), int(index / 10u));
        tile[q.y][q.x] = source_at(origin + q, size);
    }
    barrier();
}
shared float weak_edges[8][8];
shared float strong_edges[8][8];
void main() {
    ivec2 size = imageSize(outputImage);
    load_tile(size);
    ivec2 local_id = ivec2(gl_LocalInvocationID.xy);
    ivec2 q = local_id + 1;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    float gx = luminance(tile[q.y][q.x + 1].rgb) - luminance(tile[q.y][q.x - 1].rgb);
    float gy = luminance(tile[q.y + 1][q.x].rgb) - luminance(tile[q.y - 1][q.x].rgb);
    float magnitude = length(vec2(gx, gy));
    weak_edges[local_id.y][local_id.x] = step(0.07, magnitude);
    strong_edges[local_id.y][local_id.x] = step(0.19, magnitude);
    barrier();

    float connected = strong_edges[local_id.y][local_id.x];
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 n = local_id + ivec2(x, y);
            if (all(greaterThanEqual(n, ivec2(0))) && all(lessThan(n, ivec2(8))))
                connected = max(connected, strong_edges[n.y][n.x] *
                                weak_edges[local_id.y][local_id.x]);
        }
    }
    if (any(greaterThanEqual(pixel, size))) return;
    vec3 memory = history_at(2, pixel - ivec2(sign(gx), sign(gy)), size).rgb;
    vec3 result = mix(tile[q.y][q.x].rgb, memory, connected * 0.25);
    result += acid_palette(atan(gy, gx) / 6.2831853 + time_f * 0.04) *
              connected * (0.7 + alpha);
    imageStore(outputImage, pixel, vec4(clamp(result, 0.0, 1.0), 1.0));
}
