#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



const float TAU = 6.28318530718;

ivec2 clampPos(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

vec2 pixelUv(ivec2 p, ivec2 size) {
    return (vec2(clampPos(p, size)) + 0.5) / vec2(size);
}

vec3 sampleSource(ivec2 p, ivec2 size) {
    return textureLod(samp, pixelUv(p, size), 0.0).rgb;
}

int effectDirection() {
    return ((iFrame / 8) & 1) == 0 ? 1 : -1;
}

vec3 hueRotate(vec3 color, float angle) {
    vec3 axis = normalize(vec3(1.0));
    float sine = sin(angle);
    float cosine = cos(angle);
    return clamp(color * cosine + cross(axis, color) * sine +
                     axis * dot(axis, color) * (1.0 - cosine),
                 0.0, 1.0);
}

vec3 kaleidoscope(ivec2 p, ivec2 size, int segments) {
    vec2 center = vec2(size) * 0.5;
    vec2 delta = vec2(p) - center;
    float angle = atan(delta.y, delta.x);
    float slice = TAU / max(float(segments), 1.0);
    angle = mod(angle, slice);
    if (angle > slice * 0.5)
        angle = slice - angle;
    return sampleSource(ivec2(center + vec2(cos(angle), sin(angle)) * length(delta)), size);
}

vec3 dynamicKaleidoscope(ivec2 p, ivec2 size) {
    int segments = 4 + abs((iFrame / 8) % 6);
    vec3 color = kaleidoscope(p, size, segments);
    return mix(color, hueRotate(color, float(effectDirection()) * 0.7),
               clamp(alpha, 0.0, 1.0));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(p, size)))
        return;
    vec3 color = dynamicKaleidoscope(p, size);
    imageStore(outputImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
}
