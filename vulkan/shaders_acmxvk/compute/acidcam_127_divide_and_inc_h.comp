#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;


vec3 source_at(ivec2 p, ivec2 s) { p = clamp(p, ivec2(0), s - 1); return textureLod(samp, (vec2(p) + 0.5) / vec2(s), 0.0).rgb; }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), s = imageSize(outputImage); if (any(greaterThanEqual(p, s))) return;
    int bands = 2 + (iFrame / 10) % 10; int band_h = max(s.y / bands, 1); int local_y = p.y % band_h; ivec2 q = ivec2(p.x, (p.y / band_h) * band_h + (local_y * bands + iFrame) % band_h);
    vec3 src = source_at(p, s), effect = source_at(q, s) * (0.5 + float(p.y / band_h) / float(bands)); imageStore(outputImage, p, vec4(mix(src, effect, alpha), 1.0));
}
