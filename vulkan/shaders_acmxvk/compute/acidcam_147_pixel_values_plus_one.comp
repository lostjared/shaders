#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define time_f ext.u2.y

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;


vec3 source_at(ivec2 p, ivec2 s) { p = clamp(p, ivec2(0), s - 1); return textureLod(samp, (vec2(p) + 0.5) / vec2(s), 0.0).rgb; }
uvec3 bytes(vec3 c) { return uvec3(clamp(c * 255.0, 0.0, 255.0)); }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), s = imageSize(outputImage); if (any(greaterThanEqual(p, s))) return;
    vec3 src = source_at(p, s); vec3 sum = src + source_at(p + ivec2(1, 0), s) + source_at(p + ivec2(0, 1), s) + source_at(p + ivec2(1, 1), s); uint gain = uint(1.0 + 3.0 * (0.5 + 0.5 * sin(time_f)));
    vec3 effect = vec3(bytes(src) ^ ((bytes(sum * 0.25) * gain + 1u) & 255u)) / 255.0; imageStore(outputImage, p, vec4(mix(src, effect, alpha), 1.0));
}
