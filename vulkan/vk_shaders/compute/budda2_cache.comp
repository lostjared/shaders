#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define history_head int(ext.u3.x)
#define iFrame int(ext.u2.x)


// ----------------------------------------------------------------------------------
// Buddhabrot Field and Coloring Compute Shader (v2.0)
// This shader replaces the original texture-clamping logic with a dynamic
// Buddhabrot-style fire fractal, while retaining input variables and history
// for a complex, moving effect.
// ----------------------------------------------------------------------------------

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;

// Retained inputs
layout(set = 0, binding = 0) uniform sampler2D samp;



// Original utilities
ivec2 clampPos(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

vec2 pixelUv(ivec2 p, ivec2 size) {
    return (vec2(clampPos(p, size)) + 0.5) / vec2(size);
}

// History texture parameters and logic (retained)
#ifndef SIZE
#define SIZE 8
#endif

#ifndef USE_HISTORY_TEXTURE_ARRAY
#define USE_HISTORY_TEXTURE_ARRAY 1
#endif

#if USE_HISTORY_TEXTURE_ARRAY
layout(set = 0, binding = 2) uniform sampler2DArray history;

#else
uniform sampler2D textures[SIZE];
#endif

vec3 sampleHistory(int index, ivec2 p, ivec2 size) {
    vec2 uv = pixelUv(p, size);
    index = clamp(index, 0, SIZE - 1);
#if USE_HISTORY_TEXTURE_ARRAY
    int layer = (history_head + index) % SIZE;
    return textureLod(history, vec3(uv, float(layer)), 0.0).rgb;
#else
    return textureLod(textures[index], uv, 0.0).rgb;
#endif
}

// ----------------------------------------------------------------------------------
// --- NEW CORE BUDDHABROT LOGIC ---
// ----------------------------------------------------------------------------------

// Pre-defined color ramp for the fire look
vec3 fireRamp(float t) {
    // Basic fire colors (dark red, orange, yellow, white)
    vec3 c0 = vec3(0.1, 0.0, 0.0); // deep void red
    vec3 c1 = vec3(0.6, 0.2, 0.0); // rich orange
    vec3 c2 = vec3(1.0, 0.8, 0.2); // yellow-hot
    vec3 c3 = vec3(1.0, 1.0, 1.0); // pure white hot
    
    float pos = t * 3.0; // split into 3 segments
    
    if (pos < 1.0) return mix(c0, c1, pos);
    if (pos < 2.0) return mix(c1, c2, pos - 1.0);
    return mix(c2, c3, pos - 2.0);
}

// Function to generate the animated base Buddhabrot-style fire fractal
vec3 renderBaseBuddabrot(ivec2 p, ivec2 size) {
    float time = float(iFrame) * 0.01;
    vec2 uv = pixelUv(p, size);
    
    // Scale and center the coordinate system for the fractal
    vec2 c = (uv - 0.5) * 4.0;
    c.x *= float(size.x) / float(size.y);
    
    // Buddhabrot-specific modification for the complex number
    // to give a unique, dynamic form and fire-like wispiness
    float theta = time * 0.2;
    mat2 rot = mat2(cos(theta), sin(theta), -sin(theta), cos(theta));
    c *= rot;
    
    // Add a pulsing, time-dependent center point for dynamic look
    c += vec2(0.3 * sin(time), 0.2 * cos(time));

    vec2 z = vec2(0.0);
    float density = 0.0;
    
    // The Mandelbrot iteration loop, but collecting density along the orbit path
    for (int i = 0; i < 150; ++i) {
        // z = z*z + c (Standard Mandelbrot equation)
        z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
        
        // --- Buddhabrot key modification ---
        // We sum contributions along the orbit path. We color by a factor 
        // based on the iteration count AND proximity to the origin. 
        // Higher iterations contribute a special field.
        float it_factor = float(i) / 150.0;
        density += exp(-4.0 * dot(z, z)) * (1.0 + 0.5 * sin(float(i) * 0.1 + time));
        
        // Simple escape check
        if (dot(z, z) > 16.0) {
            break;
        }
    }
    
    // Convert accumulated density to a color factor and apply ramp
    float colFactor = clamp(density * 0.05, 0.0, 1.0);
    vec3 baseColor = fireRamp(colFactor);
    
    // Apply a vignetting effect and a final gamma correct for depth
    float distToCenter = length(uv - 0.5);
    baseColor *= (1.0 - smoothstep(0.3, 0.7, distToCenter));
    
    return pow(baseColor, vec3(1.2)); // deeper fire tones
}

// ----------------------------------------------------------------------------------
// --- END NEW CORE LOGIC ---
// ----------------------------------------------------------------------------------

// Original function logic, repurposed to generate fractal as the base.
// Instead of sampling from samp, it calls renderBaseBuddabrot.
vec3 sampleSource(ivec2 p, ivec2 size) {
    // Generate the base fractal directly.
    vec3 generatedFractal = renderBaseBuddabrot(p, size);
    
    // Blends the newly generated fractal with a black base based on alpha
    return mix(vec3(0.0), generatedFractal, clamp(alpha, 0.0, 1.0));
}

// Original effect block size and square block history
int effectBlockSize() {
    return max(int(round(mix(2.0, 64.0, clamp(alpha, 0.0, 1.0)))), 1);
}

vec3 squareBlockHistory(ivec2 p, ivec2 size) {
    int block = effectBlockSize();
    int blocksPerRow = (size.x + block - 1) / block;
    int blockIndex = (p.y / block) * blocksPerRow + p.x / block;
    int maximum = SIZE - 1;
    int cycle = max(maximum * 2, 1);
    int stepIndex = (iFrame + blockIndex) % cycle;
    int textureIndex = stepIndex <= maximum ? stepIndex : cycle - stepIndex;
    
    // Blend the newly generated fractal with the glitchy feedback of history
    return mix(sampleSource(p, size), sampleHistory(textureIndex, p, size), 0.5);
}

// Simplified main function to execute the new pipeline
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(p, size)))
        return;
    
    // Calculate final color using the modified squareBlockHistory
    // which now generates and mixes the fire fractal.
    vec3 color = squareBlockHistory(p, size);
    
    imageStore(outputImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
}