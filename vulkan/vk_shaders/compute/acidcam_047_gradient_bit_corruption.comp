#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



const float INV_255 = 1.0 / 255.0;

float luma(vec3 color) {
    return dot(color, vec3(0.299, 0.587, 0.114));
}

float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(41.7, 289.1))) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size)))
        return;

    float strength = clamp(alpha, 0.0, 1.0);
    vec3 source = source_at(position, size);
    uint luminance = uint(clamp(luma(source) * 255.0 + 0.5, 0.0, 255.0));
    ivec2 cell = position / ivec2(24, 8);
    uint key = uint(hash12(vec2(cell) + floor(float(iFrame) / 6.0)) * 255.0);
    uint mask = (key << uint(cell.x & 3)) | (key >> uint(8 - (cell.x & 3)));
    uint corrupted = (luminance ^ mask) & 255u;

    vec3 gradient = vec3(float(corrupted),
                         float((corrupted * 5u + key) & 255u),
                         float((255u - corrupted) ^ (key >> 1u))) *
                    INV_255;
    float scan_gate = step(1.0 - 0.85 * strength,
                           hash12(vec2(cell.y, floor(float(iFrame) / 3.0))));
    vec3 color = mix(source, gradient, scan_gate * (0.35 + 0.65 * strength));
    imageStore(outputImage, position, vec4(clamp(color, 0.0, 1.0), 1.0));
}
