#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;

ivec2 clampPos(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

vec2 pixelUv(ivec2 p, ivec2 size) {
    return (vec2(clampPos(p, size)) + 0.5) / vec2(size);
}

vec3 sampleSource(ivec2 p, ivec2 size) {
    return textureLod(samp, pixelUv(p, size), 0.0).rgb;
}

float medianValue(float values[9]) {
    for (int i = 0; i < 9; ++i) {
        for (int j = i + 1; j < 9; ++j) {
            if (values[j] < values[i]) {
                float temporary = values[i];
                values[i] = values[j];
                values[j] = temporary;
            }
        }
    }
    return values[4];
}

vec3 median3x3(ivec2 p, ivec2 size) {
    float red[9];
    float green[9];
    float blue[9];
    int index = 0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec3 color = sampleSource(p + ivec2(x, y), size);
            red[index] = color.r;
            green[index] = color.g;
            blue[index] = color.b;
            ++index;
        }
    }
    return vec3(medianValue(red), medianValue(green), medianValue(blue));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(p, size)))
        return;
    vec3 color = median3x3(p, size);
    imageStore(outputImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
}
