// Cooperative compute effect inspired by shaders_new; requires workgroup synchronization.
#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define history_head int(ext.u3.x)
#define iFrame int(ext.u2.x)
#define iResolution ext.u0.zw
#define time_f ext.u2.y


layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;





#ifndef SIZE
#define SIZE 8
#endif
#ifndef USE_HISTORY_TEXTURE_ARRAY
#define USE_HISTORY_TEXTURE_ARRAY 1
#endif

#if USE_HISTORY_TEXTURE_ARRAY
layout(set = 0, binding = 2) uniform sampler2DArray history;

#else
uniform sampler2D textures[SIZE];
#endif

shared vec4 tile[10][10];

ivec2 clamp_position(ivec2 position, ivec2 size) {
    return clamp(position, ivec2(0), size - ivec2(1));
}

vec4 source_at(ivec2 position, ivec2 size) {
    vec2 uv = (vec2(clamp_position(position, size)) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0);
}

vec4 history_at(int index, ivec2 position, ivec2 size) {
    vec2 uv = (vec2(clamp_position(position, size)) + 0.5) / vec2(size);
    index = clamp(index, 0, min(SIZE, 8) - 1);
#if USE_HISTORY_TEXTURE_ARRAY
    return textureLod(history, vec3(uv, float((history_head + index) % SIZE)), 0.0);
#else
    if (index == 0) return textureLod(textures[0], uv, 0.0);
#if SIZE > 1
    if (index == 1) return textureLod(textures[1], uv, 0.0);
#endif
#if SIZE > 2
    if (index == 2) return textureLod(textures[2], uv, 0.0);
#endif
#if SIZE > 3
    if (index == 3) return textureLod(textures[3], uv, 0.0);
#endif
#if SIZE > 4
    if (index == 4) return textureLod(textures[4], uv, 0.0);
#endif
#if SIZE > 5
    if (index == 5) return textureLod(textures[5], uv, 0.0);
#endif
#if SIZE > 6
    if (index == 6) return textureLod(textures[6], uv, 0.0);
#endif
#if SIZE > 7
    return textureLod(textures[7], uv, 0.0);
#else
    return textureLod(textures[0], uv, 0.0);
#endif
#endif
}

float luminance(vec3 color_value) {
    return dot(color_value, vec3(0.2126, 0.7152, 0.0722));
}

vec3 acid_palette(float phase) {
    return 0.5 + 0.5 * cos(6.2831853 * (phase + vec3(0.02, 0.35, 0.68)));
}

void load_tile(ivec2 size) {
    uint linear_index = gl_LocalInvocationIndex;
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 8 - 1;
    for (uint index = linear_index; index < 100u; index += 64u) {
        ivec2 local_position = ivec2(int(index % 10u), int(index / 10u));
        tile[local_position.y][local_position.x] =
            source_at(origin + local_position, size);
    }
    barrier();
}
void main() {
    ivec2 size = imageSize(outputImage);
    load_tile(size);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size)))
        return;

    ivec2 local_position = ivec2(gl_LocalInvocationID.xy) + 1;
    vec4 values[9];
    int cursor = 0;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x)
            values[cursor++] = tile[local_position.y + y][local_position.x + x];

    for (int index = 1; index < 9; ++index) {
        vec4 key = values[index];
        int position = index - 1;
        while (position >= 0 && luminance(values[position].rgb) > luminance(key.rgb)) {
            values[position + 1] = values[position];
            --position;
        }
        values[position + 1] = key;
    }
    vec3 median_color = values[4].rgb;
    vec3 memory = history_at((iFrame / 5) % min(SIZE, 8), pixel, size).rgb;
    vec3 result = mix(median_color, memory, 0.18 + 0.32 * alpha);
    result *= 0.72 + 0.42 * acid_palette(luminance(result) + time_f * 0.025);
    imageStore(outputImage, pixel, vec4(clamp(result, 0.0, 1.0), 1.0));
}
