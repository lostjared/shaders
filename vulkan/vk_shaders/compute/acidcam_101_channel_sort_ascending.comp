#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;

vec3 source_at(ivec2 p, ivec2 s) { p = clamp(p, ivec2(0), s - 1); return textureLod(samp, (vec2(p) + 0.5) / vec2(s), 0.0).rgb; }
float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), s = imageSize(outputImage); if (any(greaterThanEqual(p, s))) return;
    ivec2 base = ivec2((p.x / 16) * 16, p.y); vec3 selected = source_at(base, s); float rank = float(p.x % 16) / 15.0;
    for (int i = 1; i < 16; ++i) { vec3 c = source_at(base + ivec2(i, 0), s); if (abs(luma(c) - rank) < abs(luma(selected) - rank)) selected = c; }
    vec3 src = source_at(p, s); imageStore(outputImage, p, vec4(mix(src, selected, alpha), 1.0));
}
