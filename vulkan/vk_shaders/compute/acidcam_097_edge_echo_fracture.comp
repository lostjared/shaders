#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define time_f ext.u2.y


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    float left = luminance(source_at(position - ivec2(2, 0), size));
    float right = luminance(source_at(position + ivec2(2, 0), size));
    float up = luminance(source_at(position - ivec2(0, 2), size));
    float down = luminance(source_at(position + ivec2(0, 2), size));
    vec2 gradient = vec2(right - left, down - up);
    float edge = smoothstep(0.05, 0.32, length(gradient));
    vec2 normal = normalize(gradient + vec2(0.0001));
    float pulse = 18.0 + 28.0 * sin(time_f * 3.0 + float(position.y) * 0.02);
    ivec2 echo_offset = ivec2(normal * pulse * alpha);
    vec3 source = source_at(position, size);
    vec3 echo = source_at(position + echo_offset, size).gbr;
    echo += source_at(position - echo_offset * 2, size).brg * 0.35;
    vec3 color = mix(source, echo, edge * alpha);
    imageStore(outputImage, position, vec4(color, 1.0));
}
