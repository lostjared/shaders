#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define history_head int(ext.u3.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;

const float INV_255 = 1.0 / 255.0;

ivec2 clampPos(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

vec2 pixelUv(ivec2 p, ivec2 size) {
    return (vec2(clampPos(p, size)) + 0.5) / vec2(size);
}

vec3 sampleSource(ivec2 p, ivec2 size) {
    return textureLod(samp, pixelUv(p, size), 0.0).rgb;
}

uvec3 toU8(vec3 color) {
    return uvec3(clamp(color * 255.0 + 0.5, 0.0, 255.0));
}

vec3 toRGB(uvec3 color) {
    return vec3(color) * INV_255;
}

uvec3 sampleSourceU8(ivec2 p, ivec2 size) {
    return toU8(sampleSource(p, size));
}

#ifndef SIZE
#define SIZE 8
#endif

#ifndef USE_HISTORY_TEXTURE_ARRAY
#define USE_HISTORY_TEXTURE_ARRAY 1
#endif

#if USE_HISTORY_TEXTURE_ARRAY
layout(set = 0, binding = 2) uniform sampler2DArray history;

#else
uniform sampler2D textures[SIZE];
#endif

vec3 sampleHistory(int index, ivec2 p, ivec2 size) {
    vec2 uv = pixelUv(p, size);
    index = clamp(index, 0, SIZE - 1);
#if USE_HISTORY_TEXTURE_ARRAY
    int layer = (history_head + index) % SIZE;
    return textureLod(history, vec3(uv, float(layer)), 0.0).rgb;
#else
    return textureLod(textures[index], uv, 0.0).rgb;
#endif
}

uvec3 sampleHistoryU8(int index, ivec2 p, ivec2 size) {
    return toU8(sampleHistory(index, p, size));
}

vec3 xorHistory(ivec2 p, ivec2 size) {
    uvec3 accumulated = uvec3(0u);
    for (int index = 0; index < SIZE; ++index)
        accumulated += sampleHistoryU8(index, p, size);
    uvec3 value = (accumulated + uvec3(1u)) & uvec3(255u);
    return toRGB(sampleSourceU8(p, size) ^ value);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(p, size)))
        return;
    vec3 color = xorHistory(p, size);
    imageStore(outputImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
}
