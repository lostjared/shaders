#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define iFrame int(ext.u2.x)


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(41.7, 289.1))) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    ivec2 block_size = ivec2(32, 18);
    ivec2 cell = position / block_size;
    float lost = hash12(vec2(cell) + float(iFrame / 7));
    ivec2 sample_position = position;
    if (lost > mix(0.97, 0.58, alpha)) {
        int source_row = int(hash12(vec2(cell.y, iFrame / 11)) * float(max(size.y, 1)));
        sample_position.y = source_row + position.y % block_size.y;
        sample_position.x += int((hash12(vec2(cell.x, iFrame)) - 0.5) * 96.0);
    }
    vec3 color = source_at(sample_position, size);
    imageStore(outputImage, position, vec4(color, 1.0));
}
