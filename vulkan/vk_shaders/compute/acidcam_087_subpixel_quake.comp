#version 450

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;
#define alpha ext.u0.x
#define time_f ext.u2.y


layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;
layout(set = 0, binding = 0) uniform sampler2D samp;



vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    float row_phase = floor(float(position.y) / 4.0) * 1.618 + time_f * 19.0;
    float column_phase = floor(float(position.x) / 7.0) * 2.414 - time_f * 13.0;
    ivec2 quake = ivec2(vec2(sin(row_phase) * 7.0, cos(column_phase) * 5.0) *
                        (1.0 + alpha * 3.0));
    int split = int(2.0 + alpha * 13.0);
    vec3 source = source_at(position, size);
    vec3 fractured = vec3(source_at(position + quake + ivec2(split, 0), size).r,
                           source_at(position + quake, size).g,
                           source_at(position + quake - ivec2(split, 0), size).b);
    float flicker = 0.8 + 0.2 * sin(float(position.y) * 3.14159265 + time_f * 31.0);
    imageStore(outputImage, position, vec4(mix(source, fractured * flicker, alpha), 1.0));
}
