#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;
uniform sampler2D samp; uniform float alpha;
vec3 source_at(ivec2 p, ivec2 s) { p = clamp(p, ivec2(0), s - 1); return textureLod(samp, (vec2(p) + 0.5) / vec2(s), 0.0).rgb; }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), s = imageSize(outputImage); if (any(greaterThanEqual(p, s))) return;
    vec3 src = source_at(p, s), mirror = source_at(s - 1 - p, s); vec3 energy = abs(src - mirror) * (src + mirror); vec3 effect = pow(clamp(energy, 0.0, 1.0), vec3(1.7));
    imageStore(outputImage, p, vec4(mix(src, effect, alpha), 1.0));
}
