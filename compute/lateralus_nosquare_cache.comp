#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;
uniform sampler2D samp;
#ifndef SIZE
#define SIZE 8
#endif

#ifndef USE_HISTORY_TEXTURE_ARRAY
#define USE_HISTORY_TEXTURE_ARRAY 1
#endif

#if USE_HISTORY_TEXTURE_ARRAY
uniform sampler2DArray history;
uniform int history_head;
#else
uniform sampler2D textures[SIZE];
#endif


float alpha = 1.0;
uniform int iFrame;
uniform float time_f;
uniform vec4 iMouse;

const float TAU = 6.28318530718;
const float PHI = 1.61803398875;

ivec2 clampPos(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

vec2 pixelUv(ivec2 p, ivec2 size) {
    return (vec2(clampPos(p, size)) + 0.5) / vec2(size);
}

vec3 acidPalette(float t, float hueOffset) {
    vec3 a = vec3(0.5, 0.5, 0.5);
    vec3 b = vec3(0.5, 0.5, 0.5);
    vec3 c = vec3(1.0, 1.0, 0.5);
    vec3 d = vec3(0.3, 0.2, 0.2) + vec3(hueOffset, hueOffset * 1.2, hueOffset * 0.8);
    return a + b * cos(TAU * (c * t + d));
}

vec3 fetchHistory(int index, vec2 uv) {
    index = clamp(index, 0, SIZE - 1);
    vec2 clampedUv = clamp(uv, 0.0, 1.0);
#if USE_HISTORY_TEXTURE_ARRAY
    int layer = (history_head + index) % SIZE;
    return textureLod(history, vec3(clampedUv, float(layer)), 0.0).rgb;
#else
    return textureLod(textures[index], clampedUv, 0.0).rgb;
#endif
}

float getGoldenSpiral(vec2 uv, vec2 center, float time, float frequency) {
    vec2 p = uv - center;
    float r = length(p);
    float angle = atan(p.y, p.x);
    float goldenAngle = TAU / (PHI * PHI);
    float targetAngle = (r * frequency * 18.0) + angle - (time * 0.618);
    float spiralMask = mod(targetAngle, goldenAngle);
    
    float thickness = 0.04 + alpha * 0.12;
    spiralMask = smoothstep(thickness, 0.0, abs(spiralMask - thickness * 0.5));
    spiralMask *= smoothstep(0.75, 0.25, r) * smoothstep(0.0, 0.08, r);
    return spiralMask;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(p, size)))
        return;

    vec2 uv = pixelUv(p, size);
    float aspect = float(size.x) / float(size.y);
    vec2 aspectUv = (uv - 0.5) * vec2(aspect, 1.0);

    float t = (time_f > 0.0) ? time_f : float(iFrame) * 0.015;

    int maximum = SIZE - 1;
    int cycle = max(maximum * 2, 1);
    int stepIndex = iFrame % cycle;
    int primaryHistoryIndex = stepIndex <= maximum ? stepIndex : cycle - stepIndex;

    vec2 mouseUV = iMouse.xy / vec2(size);
    float globalHue = 0.0;
    if (iMouse.w > 0.0) {
        globalHue = (mouseUV.x - 0.5) * 3.0;
    }

    vec2 effectOrigin = vec2(0.0);
    if (iMouse.z > 0.0) {
        effectOrigin = (mouseUV - 0.5) * vec2(aspect, 1.0);
    }

    vec2 src1 = effectOrigin + vec2(sin(t * 0.35) * 0.25, cos(t * 0.45) * 0.18);
    vec2 src2 = effectOrigin + vec2(-sin(t * 0.55) * 0.18, sin(t * 0.35) * 0.22);
    vec2 src3 = effectOrigin + vec2(cos(t * 0.25) * 0.12, -cos(t * 0.65) * 0.12);

    float r1 = length(aspectUv - src1);
    float r2 = length(aspectUv - src2);
    float r3 = length(aspectUv - src3);
    float smoothFreq = mix(8.0, 55.0, clamp(alpha, 0.0, 1.0));
    float wave1 = sin(r1 * (16.0 + smoothFreq * 0.4) - t * 4.0);
    float wave2 = sin(r2 * (20.0 + smoothFreq * 0.25) - t * 3.2);
    float wave3 = sin(r3 * (24.0 + smoothFreq * 0.3) - t * 5.1);
    float waveCombined = (wave1 + wave2 + wave3) / 3.0;
    vec2 distort = vec2(
        waveCombined * 0.04 * (1.0 + alpha),
        (wave1 - wave2) * 0.03 * (1.0 + alpha)
    );
    vec2 sampUv = uv + distort;
    float chroma = abs(waveCombined) * 0.05 + (alpha * 0.02);
    vec3 liveColor;
    liveColor.r = textureLod(samp, clamp(sampUv + vec2(chroma, 0.0), 0.0, 1.0), 0.0).r;
    liveColor.g = textureLod(samp, clamp(sampUv, 0.0, 1.0), 0.0).g;
    liveColor.b = textureLod(samp, clamp(sampUv - vec2(chroma, 0.0), 0.0, 1.0), 0.0).b;
    float interferenceVal = waveCombined * 0.5 + 0.5;
    liveColor *= acidPalette(interferenceVal + t * 0.1, globalHue) * 1.4;
    float spiralMask = getGoldenSpiral(uv, vec2(0.5) + (effectOrigin / vec2(aspect, 1.0)), t, smoothFreq);
    vec3 spiralColor = acidPalette(r1 * 0.8 - t * 0.4, globalHue + 0.3);
    liveColor = mix(liveColor, spiralColor * 1.6, spiralMask * 0.85);
    vec3 accum = liveColor;
    float accWeight = 1.0;
    vec2 feedbackCenter = (iMouse.z > 0.0) ? mouseUV : (vec2(0.5) + distort * 1.5);

    for (int i = 0; i < 8; i++) {
        float gen = float(i + 1);
        int layerIndex = (primaryHistoryIndex + i) % SIZE;
        float zoomFactor = max(0.96 - (alpha * 0.05) + (0.015 * sin(t * 0.5)), 0.02);
        float rotFactor = (0.025 * sin(t * 0.3)) + (alpha * 0.01);

        float currentZoom = pow(zoomFactor, gen);
        float currentRot = rotFactor * gen;
        float c = cos(currentRot);
        float s = sin(currentRot);

        vec2 centered = uv - feedbackCenter;
        centered *= currentZoom;
        centered = vec2(centered.x * c - centered.y * s, centered.x * s + centered.y * c);
        vec2 fbUv = centered + feedbackCenter;

        vec3 cached = fetchHistory(layerIndex, fbUv);
        float shift = gen * 0.04;
        cached.r *= 1.0 + shift;
        cached.g *= 1.0 - shift * 0.5;
        cached.b *= 1.0 + shift * 0.8;

        float weight = pow(0.80, gen);
        accum += cached * weight;
        accWeight += weight;
    }

    accum /= accWeight;
    accum = (accum - 0.5) * (1.2 + alpha * 0.3) + 0.5;
    accum = clamp(accum, 0.0, 1.0);
    imageStore(outputImage, p, vec4(accum, 1.0));
}
