#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    vec3 source = source_at(position, size);
    vec3 levels = mix(vec3(255.0), vec3(7.0, 15.0, 3.0), alpha);
    vec3 crushed = floor(source * levels + 0.5) / levels;
    int cell_code = (position.x / 16) + (position.y / 16) * 3 + iFrame / 8;
    if ((cell_code & 7) == 0) crushed = crushed.gbr;
    if ((cell_code & 15) == 3) crushed = vec3(1.0) - crushed;
    imageStore(outputImage, position, vec4(mix(source, crushed, alpha), 1.0));
}
