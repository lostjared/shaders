#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(157.7, 341.3))) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return texelFetch(samp, position, 0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    int band = position.y / 9;
    float noise = hash12(vec2(float(band), float(iFrame / 3)));
    int spread = int((noise - 0.5) * 130.0 * alpha);
    vec3 left = source_at(position - ivec2(spread, 0), size);
    vec3 right = source_at(position + ivec2(spread, 0), size);
    vec3 source = source_at(position, size);
    float luma = dot(source, vec3(0.299, 0.587, 0.114));
    vec2 chroma = vec2(right.r - luma, left.b - luma);
    float static_noise = hash12(vec2(position) + float(iFrame)) - 0.5;
    vec3 noisy = vec3(luma + chroma.x, luma - 0.35 * (chroma.x + chroma.y), luma + chroma.y);
    noisy += static_noise * alpha * step(0.7, noise) * 0.35;
    imageStore(outputImage, position, vec4(mix(source, noisy, alpha), 1.0));
}
