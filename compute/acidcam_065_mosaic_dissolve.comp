#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform float time_f;

float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(39.346, 11.135))) * 9358.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    int block = max(3, int(mix(28.0, 7.0, alpha)));
    ivec2 cell = position / block;
    ivec2 center = cell * block + ivec2(block / 2);
    float random_value = hash12(vec2(cell));
    float sweep = fract(time_f * 0.12 + random_value);
    float dissolve = smoothstep(0.35, 0.75, sweep) * alpha;
    vec3 source = source_at(position, size);
    vec3 mosaic = source_at(center, size);
    mosaic = mix(mosaic, mosaic.brg, step(0.72, random_value));
    imageStore(outputImage, position, vec4(mix(source, mosaic, dissolve), 1.0));
}
