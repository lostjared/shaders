#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(17.27, 83.91))) * 41317.781);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    int cell_size = 10;
    ivec2 cell = position / cell_size;
    vec2 seed = vec2(cell) + float(iFrame / 3);
    ivec2 jitter = ivec2((hash12(seed) - 0.5) * 26.0,
                         (hash12(seed.yx + 8.4) - 0.5) * 26.0);
    float activity = step(mix(0.96, 0.38, alpha), hash12(seed + 19.2));
    ivec2 sample_position = position + ivec2(vec2(jitter) * activity * alpha);
    vec3 color = source_at(sample_position, size);
    imageStore(outputImage, position, vec4(color, 1.0));
}
