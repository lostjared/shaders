#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform float time_f;

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    float normalized_y = float(position.y) / float(max(size.y, 1));
    float tear_center = fract(time_f * 0.17);
    float distance_to_tear = abs(fract(normalized_y - tear_center + 0.5) - 0.5);
    float tear = smoothstep(0.12, 0.0, distance_to_tear);
    float ripple = sin(normalized_y * 170.0 + time_f * 13.0);
    int offset = int((tear * (0.7 + 0.3 * ripple)) * float(size.x) * 0.22 * alpha);
    ivec2 sample_position = ivec2((position.x + offset + size.x) % size.x, position.y);
    vec3 color = source_at(sample_position, size);
    color.r = source_at(ivec2((sample_position.x + offset / 12 + size.x) % size.x,
                              position.y), size).r;
    imageStore(outputImage, position, vec4(color, 1.0));
}
