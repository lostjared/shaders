#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(269.5, 183.3))) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    ivec2 cell = position / ivec2(3, 5);
    float damage = hash12(vec2(cell / ivec2(7, 3)) + float(iFrame / 30));
    vec3 source = source_at(position, size);
    int subpixel = position.x % 3;
    vec3 lcd_mask = subpixel == 0 ? vec3(1.0, 0.28, 0.28) :
                    subpixel == 1 ? vec3(0.28, 1.0, 0.28) : vec3(0.28, 0.28, 1.0);
    float stuck = step(mix(0.995, 0.82, alpha), damage);
    vec3 stuck_color = hash12(vec2(cell) + 3.0) > 0.5 ? lcd_mask : vec3(0.0);
    vec3 color = mix(source, source * lcd_mask * 1.65, alpha * 0.45);
    color = mix(color, stuck_color, stuck * alpha);
    imageStore(outputImage, position, vec4(color, 1.0));
}
