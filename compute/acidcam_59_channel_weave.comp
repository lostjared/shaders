#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform float time_f;

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    float row = float(position.y);
    int red_offset = int(sin(row * 0.047 + time_f * 4.1) * 34.0 * alpha);
    int green_offset = int(sin(row * 0.061 - time_f * 2.7) * 22.0 * alpha);
    int blue_offset = int(cos(row * 0.039 + time_f * 3.3) * 42.0 * alpha);
    vec3 color = vec3(source_at(position + ivec2(red_offset, 0), size).r,
                      source_at(position + ivec2(green_offset, 0), size).g,
                      source_at(position + ivec2(blue_offset, 0), size).b);
    imageStore(outputImage, position, vec4(color, 1.0));
}
