#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(41.3, 289.7))) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    ivec2 tile_size = ivec2(36, 28);
    ivec2 tile = position / tile_size;
    ivec2 local_position = position % tile_size;
    float seed = hash12(vec2(tile) + float(iFrame / 12));
    ivec2 mirrored = local_position;
    if ((int(seed * 8.0) & 1) != 0) mirrored.x = tile_size.x - 1 - mirrored.x;
    if ((int(seed * 8.0) & 2) != 0) mirrored.y = tile_size.y - 1 - mirrored.y;
    ivec2 shifted_tile = tile + ivec2(int(seed * 5.0) - 2, int(seed * 11.0) % 3 - 1);
    ivec2 corrupt_position = shifted_tile * tile_size + mirrored;
    float gate = step(mix(0.94, 0.38, alpha), seed);
    vec3 color = mix(source_at(position, size), source_at(corrupt_position, size).gbr, gate * alpha);
    imageStore(outputImage, position, vec4(color, 1.0));
}
