#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(127.1, 311.7))) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    ivec2 block = position / ivec2(40, 24);
    float seed = hash12(vec2(block) + float(iFrame / 5));
    int offset = int((seed - 0.5) * 72.0 * alpha);
    ivec2 direction = ivec2(offset, int((hash12(vec2(block.yx) + 19.0) - 0.5) * 12.0 * alpha));
    vec3 source = source_at(position, size);
    vec3 split = vec3(source_at(position + direction, size).r,
                      source.g,
                      source_at(position - direction, size).b);
    float glitch_active = step(mix(0.93, 0.40, alpha), seed);
    imageStore(outputImage, position, vec4(mix(source, split, glitch_active), 1.0));
}
