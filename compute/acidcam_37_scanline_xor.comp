#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;

const float INV_255 = 1.0 / 255.0;

ivec2 clampPos(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

vec2 pixelUv(ivec2 p, ivec2 size) {
    return (vec2(clampPos(p, size)) + 0.5) / vec2(size);
}

vec3 sampleSource(ivec2 p, ivec2 size) {
    return textureLod(samp, pixelUv(p, size), 0.0).rgb;
}

uvec3 toU8(vec3 color) {
    return uvec3(clamp(color * 255.0 + 0.5, 0.0, 255.0));
}

vec3 toRGB(uvec3 color) {
    return vec3(color) * INV_255;
}

uvec3 sampleSourceU8(ivec2 p, ivec2 size) {
    return toU8(sampleSource(p, size));
}

int effectBlockSize() {
    return max(int(round(mix(2.0, 64.0, clamp(alpha, 0.0, 1.0)))), 1);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(p, size)))
        return;
    vec3 color = toRGB(sampleSourceU8(p, size) ^ sampleSourceU8(p + ivec2(0, effectBlockSize()), size));
    imageStore(outputImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
}
