#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

float hash12(vec2 value) {
    return fract(sin(dot(value, vec2(12.9898, 78.233))) * 43758.5453);
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    vec3 source = source_at(position, size);
    float burst = hash12(vec2(position / ivec2(3, 2)) + float(iFrame) * 1.37);
    float gate = step(mix(1.0, 0.72, alpha), burst);
    vec3 snow = vec3(hash12(vec2(position) + float(iFrame) * 7.1),
                     hash12(vec2(position.yx) - float(iFrame) * 3.7),
                     hash12(vec2(position) + float(iFrame) * 11.9));
    float stripe = step(0.94, hash12(vec2(position.y / 5, iFrame / 2)));
    vec3 color = mix(source, snow, max(gate, stripe) * (0.35 + 0.65 * alpha));
    imageStore(outputImage, position, vec4(color, 1.0));
}
