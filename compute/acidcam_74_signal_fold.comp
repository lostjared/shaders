#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform float time_f;

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    float fold_count = mix(3.0, 13.0, alpha);
    vec2 folded = abs(fract(uv * fold_count + vec2(time_f * 0.09, -time_f * 0.06)) * 2.0 - 1.0);
    folded = fract(folded + uv * (1.0 - alpha));
    ivec2 sample_position = ivec2(folded * vec2(size));
    vec3 folded_color = source_at(sample_position, size);
    vec3 source = source_at(position, size);
    float seam = smoothstep(0.92, 1.0, max(folded.x, folded.y));
    vec3 color = mix(source, folded_color.gbr, alpha * (0.72 + 0.28 * seam));
    imageStore(outputImage, position, vec4(color, 1.0));
}
