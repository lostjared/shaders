#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return texelFetch(samp, position, 0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    ivec2 half_size = max(size / 2, ivec2(1));
    ivec2 quadrant = clamp(position / half_size, ivec2(0), ivec2(1));
    int quadrant_id = quadrant.x + quadrant.y * 2;
    int phase = (iFrame / (3 + quadrant_id)) + quadrant_id * 17;
    ivec2 offsets[4] = ivec2[4](ivec2(1, 0), ivec2(0, 1), ivec2(-1, 0), ivec2(0, -1));
    int jump = int((12.0 + 54.0 * alpha) * sin(float(phase) * 0.17));
    ivec2 sample_position = position + offsets[quadrant_id] * jump;
    vec3 source = source_at(position, size);
    vec3 shifted = source_at(sample_position, size);
    float seam = float(any(lessThan(abs((position % half_size) - half_size / 2), ivec2(2))));
    vec3 color = mix(source, shifted, alpha * (0.65 + 0.35 * seam));
    imageStore(outputImage, position, vec4(color, 1.0));
}
