#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform float time_f;

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    vec3 source = source_at(position, size);
    float luma = luminance(source);
    float stepped_luma = floor(luma * 8.0) / 7.0 - 0.5;
    int horizontal = int(stepped_luma * mix(12.0, 150.0, alpha));
    int vertical = int(sin(luma * 31.0 + time_f * 5.0) * 14.0 * alpha);
    vec3 displaced = source_at(position + ivec2(horizontal, vertical), size);
    float contour = smoothstep(0.44, 0.50, abs(fract(luma * 8.0 + time_f * 0.2) - 0.5));
    vec3 color = mix(source, displaced, alpha * (0.72 + 0.28 * contour));
    imageStore(outputImage, position, vec4(color, 1.0));
}
