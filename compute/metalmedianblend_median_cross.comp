#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;

ivec2 clampPos(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

vec2 pixelUv(ivec2 p, ivec2 size) {
    return (vec2(clampPos(p, size)) + 0.5) / vec2(size);
}

vec3 sampleSource(ivec2 p, ivec2 size) {
    return textureLod(samp, pixelUv(p, size), 0.0).rgb;
}

float medianValue5(float values[5]) {
    for (int i = 0; i < 5; ++i) {
        for (int j = i + 1; j < 5; ++j) {
            if (values[j] < values[i]) {
                float temporary = values[i];
                values[i] = values[j];
                values[j] = temporary;
            }
        }
    }
    return values[2];
}

vec3 medianCross(ivec2 p, ivec2 size) {
    vec3 colors[5];
    colors[0] = sampleSource(p, size);
    colors[1] = sampleSource(p + ivec2(0, -1), size);
    colors[2] = sampleSource(p + ivec2(0, 1), size);
    colors[3] = sampleSource(p + ivec2(-1, 0), size);
    colors[4] = sampleSource(p + ivec2(1, 0), size);
    float red[5] = float[5](colors[0].r, colors[1].r, colors[2].r, colors[3].r, colors[4].r);
    float green[5] = float[5](colors[0].g, colors[1].g, colors[2].g, colors[3].g, colors[4].g);
    float blue[5] = float[5](colors[0].b, colors[1].b, colors[2].b, colors[3].b, colors[4].b);
    return vec3(medianValue5(red), medianValue5(green), medianValue5(blue));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(p, size)))
        return;
    vec3 color = medianCross(p, size);
    imageStore(outputImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
}
