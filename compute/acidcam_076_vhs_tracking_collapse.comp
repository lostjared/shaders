#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform float time_f;

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return textureLod(samp, (vec2(position) + 0.5) / vec2(size), 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    float y = float(position.y);
    float head = fract(time_f * 0.075) * float(size.y);
    float distance_to_head = abs(y - head);
    float collapse = exp(-distance_to_head * distance_to_head / max(80.0, float(size.y) * 3.0));
    float wobble = sin(y * 0.11 + time_f * 7.0) + sin(y * 0.027 - time_f * 3.2);
    int shift = int((wobble * 5.0 + collapse * 110.0) * alpha);
    ivec2 sample_position = position + ivec2(shift, int(collapse * 9.0 * alpha));
    vec3 color = source_at(sample_position, size);
    float tracking_line = smoothstep(8.0, 0.0, distance_to_head);
    color = mix(color, color.bgr + vec3(0.12), tracking_line * alpha * 0.65);
    imageStore(outputImage, position, vec4(color, 1.0));
}
