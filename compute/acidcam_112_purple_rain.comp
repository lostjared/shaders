#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;
uniform sampler2D samp; uniform float alpha; uniform int iFrame;
vec3 source_at(ivec2 p, ivec2 s) { p = clamp(p, ivec2(0), s - 1); return textureLod(samp, (vec2(p) + 0.5) / vec2(s), 0.0).rgb; }
float hash(float x) { return fract(sin(x * 91.73) * 43758.5453); }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), s = imageSize(outputImage); if (any(greaterThanEqual(p, s))) return;
    int fall = int(mod(float(p.y) + float(iFrame) * (2.0 + hash(p.x) * 8.0), float(s.y))); vec3 src = source_at(p, s), rain = source_at(ivec2(p.x, fall), s).brg;
    rain *= vec3(0.75, 0.25, 1.35) * (0.45 + 0.55 * step(0.58, hash(float(p.x / 3)))); imageStore(outputImage, p, vec4(mix(src, rain, alpha), 1.0));
}
