// Stateful cooperative compute effect inspired by shaders_new.
#version 430 core
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;
uniform sampler2D samp;
uniform float time_f;
uniform float alpha;
uniform int iFrame;
#ifndef SIZE
#define SIZE 8
#endif
#ifndef USE_HISTORY_TEXTURE_ARRAY
#define USE_HISTORY_TEXTURE_ARRAY 0
#endif
#if USE_HISTORY_TEXTURE_ARRAY
uniform sampler2DArray history;
uniform int history_head;
#else
uniform sampler2D textures[SIZE];
#endif
shared vec4 tile[10][10];
ivec2 clamp_position(ivec2 p, ivec2 s) { return clamp(p, ivec2(0), s - 1); }
vec4 source_at(ivec2 p, ivec2 s) {
    vec2 uv = (vec2(clamp_position(p, s)) + 0.5) / vec2(s);
    return textureLod(samp, uv, 0.0);
}
vec4 history_at(int index, ivec2 p, ivec2 s) {
    vec2 uv = (vec2(clamp_position(p, s)) + 0.5) / vec2(s);
    index = clamp(index, 0, min(SIZE, 8) - 1);
#if USE_HISTORY_TEXTURE_ARRAY
    return textureLod(history, vec3(uv, float((history_head + index) % SIZE)), 0.0);
#else
    if (index == 0) return textureLod(textures[0], uv, 0.0);
#if SIZE > 1
    if (index == 1) return textureLod(textures[1], uv, 0.0);
#endif
#if SIZE > 2
    if (index == 2) return textureLod(textures[2], uv, 0.0);
#endif
#if SIZE > 3
    if (index == 3) return textureLod(textures[3], uv, 0.0);
#endif
#if SIZE > 4
    if (index == 4) return textureLod(textures[4], uv, 0.0);
#endif
#if SIZE > 5
    if (index == 5) return textureLod(textures[5], uv, 0.0);
#endif
#if SIZE > 6
    if (index == 6) return textureLod(textures[6], uv, 0.0);
#endif
#if SIZE > 7
    return textureLod(textures[7], uv, 0.0);
#else
    return textureLod(textures[0], uv, 0.0);
#endif
#endif
}
float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec3 acid_palette(float p) { return 0.5 + 0.5 * cos(6.2831853 * (p + vec3(0.08, 0.42, 0.76))); }
void load_tile(ivec2 size) {
    uint lane = gl_LocalInvocationIndex;
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 8 - 1;
    for (uint index = lane; index < 100u; index += 64u) {
        ivec2 q = ivec2(int(index % 10u), int(index / 10u));
        tile[q.y][q.x] = source_at(origin + q, size);
    }
    barrier();
}
shared vec2 flow_field[8][8];
void main() {
    ivec2 size = imageSize(outputImage);
    load_tile(size);
    ivec2 local_id = ivec2(gl_LocalInvocationID.xy);
    ivec2 q = local_id + 1;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    float left = luminance(tile[q.y][q.x - 1].rgb);
    float right = luminance(tile[q.y][q.x + 1].rgb);
    float down = luminance(tile[q.y - 1][q.x].rgb);
    float up = luminance(tile[q.y + 1][q.x].rgb);
    flow_field[local_id.y][local_id.x] = vec2(right - left, up - down);
    barrier();

    vec2 flow = flow_field[local_id.y][local_id.x];
    if (local_id.x > 0) flow += flow_field[local_id.y][local_id.x - 1] * 0.5;
    if (local_id.y > 0) flow += flow_field[local_id.y - 1][local_id.x] * 0.5;
    ivec2 displacement = ivec2(round(vec2(-flow.y, flow.x) * (10.0 + 18.0 * alpha)));
    if (any(greaterThanEqual(pixel, size))) return;
    vec3 advected = history_at(1 + (iFrame / 7) % max(min(SIZE, 8) - 1, 1),
                               pixel + displacement, size).rgb;
    vec3 video = tile[q.y][q.x].rgb;
    float strength = clamp(length(flow) * 4.0, 0.0, 1.0);
    vec3 result = mix(video, advected, 0.3 + strength * 0.5);
    result += acid_palette(atan(flow.y, flow.x) / 6.2831853 - time_f * 0.04) * strength * 0.28;
    imageStore(outputImage, pixel, vec4(clamp(result, 0.0, 1.0), 1.0));
}
