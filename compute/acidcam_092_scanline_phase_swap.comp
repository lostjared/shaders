#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform float time_f;

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    return texelFetch(samp, position, 0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    int group = position.y / 4;
    float wave = sin(float(group) * 0.47 + time_f * 6.0);
    int partner_group = group + int(wave * mix(2.0, 28.0, alpha));
    ivec2 partner = ivec2(position.x + int(wave * 35.0 * alpha), partner_group * 4 + position.y % 4);
    vec3 source = source_at(position, size);
    vec3 swapped = source_at(partner, size);
    int phase = (group + int(time_f * 8.0)) & 3;
    vec3 color = phase == 0 ? swapped.rgb :
                 phase == 1 ? vec3(swapped.r, source.g, swapped.b) :
                 phase == 2 ? swapped.gbr : vec3(source.r, swapped.g, source.b);
    imageStore(outputImage, position, vec4(mix(source, color, alpha), 1.0));
}
