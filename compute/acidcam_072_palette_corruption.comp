#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D outputImage;

uniform sampler2D samp;
uniform float alpha;
uniform int iFrame;

vec3 glitch_palette(float value, float phase) {
    return 0.5 + 0.5 * cos(6.2831853 * (value + phase + vec3(0.0, 0.34, 0.67)));
}

vec3 source_at(ivec2 position, ivec2 size) {
    position = clamp(position, ivec2(0), size - 1);
    vec2 uv = (vec2(position) + 0.5) / vec2(size);
    return textureLod(samp, uv, 0.0).rgb;
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (any(greaterThanEqual(position, size))) return;

    vec3 source = source_at(position, size);
    float luma = dot(source, vec3(0.2126, 0.7152, 0.0722));
    float band = floor(luma * mix(32.0, 6.0, alpha)) / mix(32.0, 6.0, alpha);
    float cell_phase = float((position.x / 24 + position.y / 18 + iFrame / 7) % 7) / 7.0;
    vec3 corrupted = glitch_palette(band, cell_phase);
    corrupted *= 0.55 + luma * 0.8;
    imageStore(outputImage, position, vec4(mix(source, clamp(corrupted, 0.0, 1.0), alpha), 1.0));
}
